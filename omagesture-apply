#!/usr/bin/env bash
#
# omagesture-apply — turn a settings object into Hyprland gesture config.
#
# Usage:
#   omagesture-apply '<json>'     apply these settings
#   omagesture-apply -            read the settings JSON from stdin
#   omagesture-apply              apply the built-in defaults
#
#   --print                       write the Lua to stdout and touch nothing
#   --target <path>               write somewhere other than the default file
#
# Unknown keys are ignored and missing ones fall back to DEFAULTS below, so a
# partial object is always safe — the panel sends whole objects, a human
# testing from a terminal usually sends one key.
#
# This script is the only thing that writes Lua. The bar widget shells out to
# it rather than assembling config in QML, so there is exactly one place where
# a gesture's Lua can be wrong.

set -uo pipefail

TARGET="$HOME/.config/hypr/omagesture.lua"
PRINT_ONLY=false
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INPUT=""

while (( $# )); do
  case "$1" in
    --print)  PRINT_ONLY=true; shift ;;
    --target) TARGET="${2:?--target needs a path}"; shift 2 ;;
    -h|--help) sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'; exit 0 ;;
    -)        INPUT="$(timeout 5 head -c 65536)"; shift ;;
    *)        INPUT="$1"; shift ;;
  esac
done

command -v jq >/dev/null || { echo "omagesture-apply: jq is required" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
# Kept in sync with manifest.json's barWidget.defaults and Model.js DEFAULTS.
# Three of them, because each side has to work when the other has not spoken:
# the shell settings UI reads the manifest, the panel reads Model.js, and this
# script has to produce the intended mapping when invoked bare from a shell.
read -r -d '' DEFAULTS <<'JSON'
{
  "enabled": true,
  "naturalScroll": true,
  "clickMethod": "clickfinger",
  "drag": "off",
  "middleButton": "move",
  "swipeRange": "numbered",
  "swipeForever": false,

  "g2PinchIn": "none",
  "g2PinchOut": "none",

  "g3Left": "workspace",
  "g3Right": "workspace",
  "g3Up": "menu",
  "g3Down": "none",
  "g3PinchIn": "none",
  "g3PinchOut": "none",

  "g4Left": "resize_window",
  "g4Right": "resize_window",
  "g4Up": "resize_window",
  "g4Down": "resize_window",
  "g4PinchIn": "none",
  "g4PinchOut": "none"
}
JSON

[[ -n $INPUT ]] || INPUT="{}"
if ! jq -e . >/dev/null 2>&1 <<<"$INPUT"; then
  echo "omagesture-apply: settings are not valid JSON" >&2
  exit 1
fi

SETTINGS="$(jq -s '.[0] * .[1]' <<<"$DEFAULTS
$INPUT")" || exit 1

# Deliberately not `.[$k] // "none"`: jq's alternative operator fires on false
# as well as on null, which would quietly turn every `"naturalScroll": false`
# into the string "none" and drop the setting instead of applying it.
get() { jq -r --arg k "$1" 'if has($k) and .[$k] != null then .[$k] else "none" end | tostring' <<<"$SETTINGS"; }

enabled="$(get enabled)"
natural_scroll="$(get naturalScroll)"
click_method="$(get clickMethod)"
drag="$(get drag)"
middle_button="$(get middleButton)"
swipe_range="$(get swipeRange)"
swipe_forever="$(get swipeForever)"

DIRS=(Left Right Up Down PinchIn PinchOut)
declare -A ACTION
for fi in 2 3 4; do
  for d in "${DIRS[@]}"; do
    ACTION[$fi,$d]="$(get "g${fi}${d}")"
  done
done

# ---------------------------------------------------------------------------
# Emit
# ---------------------------------------------------------------------------
OUT=()
emit() { OUT+=("$1"); }

emit "-- Generated by omagesture. Do not edit by hand — every apply rewrites it."
emit "-- Change the mapping from the Omagesture widget in the Omarchy bar, or"
emit "-- run: $SELF_DIR/omagesture-apply '{\"g3Up\":\"fullscreen\"}'"
emit ""

[[ $enabled == true ]] || emit "-- Gestures are off. The touchpad tuning below still applies."

# --- touchpad tuning -------------------------------------------------------
touchpad_opts=()
[[ $natural_scroll == true || $natural_scroll == false ]] && touchpad_opts+=("natural_scroll = $natural_scroll")
case "$click_method" in
  clickfinger) touchpad_opts+=("clickfinger_behavior = true") ;;
  buttonareas) touchpad_opts+=("clickfinger_behavior = false") ;;
esac

# A multi-finger drag and a swipe of the same finger count cannot both exist:
# libinput gives the contact to the drag and the swipe never starts. Rather
# than write config that silently does nothing, drop the drag and say why.
case "$drag" in
  threefinger) drag_value=1 ;;
  fourfinger)  drag_value=2 ;;
  *)           drag_value=0 ;;
esac

mapped() {
  local fi="$1" d
  for d in "${DIRS[@]}"; do
    [[ ${ACTION[$fi,$d]} != none ]] && return 0
  done
  return 1
}

if [[ $enabled == true ]]; then
  if [[ $drag_value == 1 ]] && mapped 3; then
    emit "-- NOTE: three-finger drag dropped — three-finger swipes are mapped, and"
    emit "-- libinput can only give those fingers to one of the two."
    drag_value=0
  elif [[ $drag_value == 2 ]] && mapped 4; then
    emit "-- NOTE: four-finger drag dropped — four-finger swipes are mapped."
    drag_value=0
  fi
fi
touchpad_opts+=("drag_3fg = $drag_value")

joined="${touchpad_opts[0]}"
for ((i = 1; i < ${#touchpad_opts[@]}; i++)); do joined+=", ${touchpad_opts[i]}"; done
emit "hl.config({ input = { touchpad = { $joined } } })"

# The touchpad block is what libinput-classified touchpads read; the global one
# covers an external mouse and anything not classified as a touchpad.
[[ $natural_scroll == true || $natural_scroll == false ]] &&
  emit "hl.config({ input = { natural_scroll = $natural_scroll } })"

# How far a workspace swipe can reach.
#
# Hyprland picks the target with the `m` selector by default, which walks only
# the workspaces that currently exist and wraps at the end — so with two
# workspaces open you can reach a third (created on the fly) and then you are
# stuck. The `r` selector targets by workspace number instead, so the swipe
# keeps going to 4, 5, 6 and back down regardless of what exists yet.
case "$swipe_range" in
  numbered) use_r=true ;;
  existing) use_r=false ;;
  *)        use_r=true ;;
esac
[[ $swipe_forever == true ]] && forever=true || forever=false
emit "hl.config({ gestures = { workspace_swipe_use_r = $use_r, workspace_swipe_forever = $forever } })"

emit ""

# --- discrete-action helper ------------------------------------------------
# Native gesture actions are continuous: Hyprland animates them under your
# fingers and needs no glue. Anything that just runs a command has to fire once
# per swipe instead of once per motion event, so it accumulates travel and then
# latches until the fingers lift.
needs_helper=false
needs_resize=false
for fi in 2 3 4; do
  for d in "${DIRS[@]}"; do
    [[ ${ACTION[$fi,$d]} == menu ]] && needs_helper=true
    [[ ${ACTION[$fi,$d]} == resize_window ]] && needs_resize=true
  done
done

if [[ $enabled == true && $needs_helper == true ]]; then
  emit 'local function omagesture_once(threshold, run)'
  emit '  local travel, fired = 0, false'
  emit '  local function step(event)'
  emit '    if fired then return end'
  emit '    local d = event and event.delta'
  emit '    travel = travel + math.abs((d and d.x) or 0) + math.abs((d and d.y) or 0)'
  emit '    if travel >= threshold then'
  emit '      fired = true'
  emit '      run()'
  emit '    end'
  emit '  end'
  emit '  return {'
  emit '    start = function(e) travel, fired = 0, false; step(e) end,'
  emit '    update = step,'
  emit '    finish = function() travel, fired = 0, false end,'
  emit '  }'
  emit 'end'
  emit ''
fi

if [[ $enabled == true && $needs_resize == true ]]; then
  # Resize by feeding each motion event straight into the same resize
  # dispatcher that SUPER + right-drag uses.
  #
  # Hyprland's native `resize` gesture action registers without complaint but
  # does nothing to a tiled window here, while
  # `hl.dsp.window.resize({ relative = true })` moves the split correctly — so
  # the gesture drives the dispatcher rather than the built-in action. Applying
  # the per-event delta keeps it continuous: the edge tracks your fingers
  # instead of jumping when you let go.
  emit 'local function omagesture_resize(axis)'
  emit '  return {'
  emit '    start = function() end,'
  emit '    update = function(event)'
  emit '      local d = event and event.delta'
  emit '      if not d then return end'
  emit '      local dx = (axis == "x") and (d.x or 0) or 0'
  emit '      local dy = (axis == "y") and (d.y or 0) or 0'
  emit '      if dx == 0 and dy == 0 then return end'
  emit '      hl.dispatch(hl.dsp.window.resize({ x = dx, y = dy, relative = true }))'
  emit '    end,'
  emit '    finish = function() end,'
  emit '  }'
  emit 'end'
  emit ''
fi

# Render an action token as the Lua that follows `direction`. Empty for "none".
#
# $2 is the direction being emitted, which resize needs: a swipe only carries
# one axis, so the handler has to know which of the two it is driving.
action_lua() {
  case "$1" in
    workspace)     printf 'action = "workspace"' ;;
    move_window)   printf 'action = "move"' ;;
    resize_window)
      case "$2" in
        vertical|up|down) printf 'action = omagesture_resize("y")' ;;
        *)                printf 'action = omagesture_resize("x")' ;;
      esac ;;
    close_window)  printf 'action = "close"' ;;
    fullscreen)    printf 'action = "fullscreen"' ;;
    maximize)      printf 'action = "fullscreen", mode = "maximize"' ;;
    float)         printf 'action = "float"' ;;
    special)       printf 'action = "special", workspace_name = "magic"' ;;
    zoom)          printf 'action = "cursorZoom", zoom_level = 2' ;;
    menu)          printf 'action = omagesture_once(40, function() hl.dispatch(hl.dsp.exec_cmd("omarchy-menu")) end)' ;;
    *)             printf '' ;;
  esac
}

gesture() { # fingers direction token
  local body; body="$(action_lua "$3" "$2")"
  [[ -n $body ]] || return 0
  emit "hl.gesture({ fingers = $1, direction = \"$2\", $body })"
}

if [[ $enabled == true ]]; then
  for fi in 2 3 4; do
    # Hyprland refuses a gesture another one already shadows, so an axis is
    # claimed either as one combined direction or as two opposing ones, never
    # both. Matching halves collapse into the combined form — which is also the
    # only shape that gives the continuous, finger-following animation.
    #
    # Pinch is an axis like the other two: `pinch` shadows both `pinchin` and
    # `pinchout`, and squeezing and spreading are the two ends of one motion.
    for axis in "horizontal:Left:Right" "vertical:Up:Down" "pinch:PinchIn:PinchOut"; do
      IFS=: read -r combined lo hi <<<"$axis"
      a="${ACTION[$fi,$lo]}"; b="${ACTION[$fi,$hi]}"
      if [[ $a == "$b" && $a != none ]]; then
        gesture "$fi" "$combined" "$a"
      else
        gesture "$fi" "${lo,,}" "$a"
        gesture "$fi" "${hi,,}" "$b"
      fi
    done

  done
fi

# What the middle button does. Under `clickfinger` that button is a
# three-finger click, so `resize` and `move` give you press-and-drag window
# handling straight from the trackpad — the same thing SUPER plus a mouse
# button does, without the keyboard.
#
# These two are drag binds (`mouse = true`), which is a different mechanism
# from the swipe gestures above: the physical button is held down, so libinput
# routes the motion as a pointer drag and never as a gesture. That also means
# they do not collide with the three-finger swipes.
case "$middle_button" in
  resize)     emit ""; emit 'hl.bind("mouse:274", hl.dsp.window.resize(), { mouse = true })' ;;
  move)       emit ""; emit 'hl.bind("mouse:274", hl.dsp.window.drag(), { mouse = true })' ;;
  screenshot) emit ""; emit 'hl.bind("mouse:274", function() hl.dispatch(hl.dsp.exec_cmd("omarchy-capture-screenshot region")) end)' ;;
  paste)      emit ""; emit 'hl.bind("mouse:274", function() hl.dispatch(hl.dsp.exec_cmd("wl-paste --primary")) end)' ;;
esac

# ---------------------------------------------------------------------------
# Write
# ---------------------------------------------------------------------------
if [[ $PRINT_ONLY == true ]]; then
  printf '%s\n' "${OUT[@]}"
  exit 0
fi

# mktemp in the target directory + mv -f: atomic, so a concurrent Hyprland
# reload never sees half a file, and a symlink planted on the target name
# cannot redirect the write.
dir="$(dirname -- "$TARGET")"
mkdir -p "$dir"
tmp="$(mktemp "$dir/.omagesture.XXXXXX")" || { echo "omagesture-apply: mktemp failed" >&2; exit 1; }
chmod 644 "$tmp" 2>/dev/null
printf '%s\n' "${OUT[@]}" > "$tmp"
mv -f "$tmp" "$TARGET"

"$SELF_DIR/omagesture-require" >/dev/null 2>&1
exit 0
